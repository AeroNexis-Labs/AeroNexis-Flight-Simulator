; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Aeronexis Flight Simulator"
config/description="Aeronexis - infinite flight simulator for mobile"
run/main_scene="res://scenes/splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.05, 0.12, 1)
config/icon="res://icon.png"
boot_splash/image="res://art/splash.png"

[autoload]

PlayerData="*res://scripts/player_data.gd"
MultiplayerSession="*res://scripts/multiplayer_session.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true
pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=1024
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=0
